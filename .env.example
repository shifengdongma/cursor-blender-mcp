# AIGV Studio Environment Configuration
# ======================================
# Copy this file to .env and configure as needed

# ── Core ──
DATA_DIR=./data
SECRET_KEY=change-me-to-a-random-secret-key
HOST=0.0.0.0
PORT=8000

# ── Video Generation Providers ──
# Seedance / Atlas Cloud (Primary)
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://api.atlascloud.ai/api/v1
SEEDANCE_MODEL_NAME=bytedance/seedance-v1.5-pro/text-to-video

# Luma Dream Machine (Optional)
LUMA_API_KEY=
LUMA_BASE_URL=https://api.lumalabs.ai/dream-machine/v1

# ── Blender Integration ──
BLENDER_BIN=blender
ENABLE_BLENDER_EXPORT=true
BLENDER_EXECUTION_MODE=local_batch

# ── Creative Production Pipeline ──
# LLM (OpenAI-compatible API)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# ComfyUI Image Generation (Optional)
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_FILE=./data/workflows/comfyui_default.json

# Piper TTS (Optional)
PIPER_BIN=piper
PIPER_MODEL_PATH=./data/tts_models/zh_CN-huayan-medium.onnx

# FFmpeg / FFprobe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# ── Cloud Provider Credentials ──
# Aliyun
ALIYUN_ACCESS_KEY=
ALIYUN_ACCESS_SECRET=
ALIYUN_REGION_ID=cn-hangzhou

# Tencent Cloud
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# VMware
VMWARE_HOST=
VMWARE_USER=
VMWARE_PASSWORD=

# Generic REST
GENERIC_REST_URL=
GENERIC_REST_TOKEN=

# ── Node Agent ──
NODE_AGENT_URLS=
NODE_AGENT_TOKEN=
NODE_POLL_INTERVAL_S=30

# ── Monitoring & Alerting ──
# Comma-separated targets: "name|type|addr,name|type|addr"
# type: tcp, http, icmp. Example: "node1|tcp|10.0.0.11:9100,api|http|http://10.0.0.12:9108/health"
MONITOR_TARGETS=
MONITOR_INTERVAL_S=5
MONITOR_TIMEOUT_S=3
STORAGE_TARGETS=assets|./data/assets,work|./data/work,jobs|./data/jobs
ENABLE_MONITORING_WORKER=true
ALERT_RULES_FILE=

# ── Security & Stability ──
LOGIN_RATE_LIMIT=10
CSRF_ENABLED=true
SESSION_SECURE=false
AUDIT_ENABLED=true
SQLITE_WAL_MODE=true

# ── Billing ──
GPU_UNIT_PRICE_CNY=120
ENGINE_UNIT_PRICE_CNY=80
STREAM_UNIT_PRICE_CNY=40
GPU_PRICE_MAP=A100:150,A10:80,L40:120
