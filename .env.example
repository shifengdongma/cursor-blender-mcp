# AIGV Studio Environment Configuration
# ======================================
# Copy this file to .env and configure as needed.
# NEVER commit real API keys or the real SECRET_KEY.

# ── Core ──
AIGV_ENV=production
DATA_DIR=./data
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Production startup fails when this is empty or a known placeholder.
SECRET_KEY=
HOST=0.0.0.0
PORT=8000
PLATFORM_TENANT_ID=tenant_platform

# ── Product / demo behaviour ──
# false = production mode: no demo users, demo GPU data or demo task records.
# Set true only for a clearly-labelled demonstration deployment.
DEMO_MODE=false
ALLOW_REGISTRATION=true

# ── AI Image / Video Providers ──
# Volcengine Ark direct API (Seedream images / Seedance video).
# Get a key at https://ark.volcengine.com/region:cn-beijing/apikey
# Model IDs are defined once in backend/model_ids.py. Leave the overrides
# below empty to use the registry. Only set an override to pin a different
# endpoint/model enabled for your account.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=
ARK_IMAGE_MODEL_FLASH=
ARK_VIDEO_MODEL=
ARK_VIDEO_MODEL_20=
ARK_VIDEO_MODEL_10_PRO=
ARK_REQUEST_TIMEOUT_S=180

# ── Volcengine management OpenAPI: read-only usage / official bills ──
# IMPORTANT: do NOT put ARK_API_KEY here.  These credentials are account-level
# management AK/SK (prefer a dedicated IAM sub-user with only read permissions)
# and are never sent to the browser, stored in SQLite, or written to audit logs.
# Leave both empty to keep the existing generation features untouched.
VOLCENGINE_USAGE_ENABLED=false
VOLCENGINE_BILLING_ENABLED=false
VOLCENGINE_ACCESS_KEY_ID=
VOLCENGINE_SECRET_ACCESS_KEY=
VOLCENGINE_ARK_REGION=cn-beijing
VOLCENGINE_BILLING_REGION=cn-north-1
VOLCENGINE_ARK_PROJECT=default
VOLCENGINE_USAGE_SYNC_ENABLED=false
VOLCENGINE_BILLING_SYNC_ENABLED=false
VOLCENGINE_USAGE_SYNC_INTERVAL_S=1800
VOLCENGINE_BILLING_SYNC_INTERVAL_S=86400
VOLCENGINE_USAGE_LOOKBACK_DAYS=31
VOLCENGINE_BILLING_LOOKBACK_MONTHS=3
VOLCENGINE_SYNC_TIMEOUT_S=20
VOLCENGINE_SYNC_MAX_RETRIES=2
# Optional official bill product filter, discovered from the real account
# (for example "ark_bd").  Leave empty to show all products with an explicit
# "all products" label; never claim Ark-only when this is empty.
VOLCENGINE_ARK_BILL_PRODUCT_FILTER=
# Optional JSON split dimension verified against the real account, e.g.
# {"ark_bd":"apikey_id"}.  Leave empty to keep official costs unattributed.
VOLCENGINE_ARK_BILL_SPLIT_DIMENSION=
# Optional API Key resource ID (NOT the API key secret) used only for display.
VOLCENGINE_ARK_API_KEY_RESOURCE_ID=

# Legacy Atlas Cloud Seedance adapter (NOT the Volcengine Ark API)
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://api.atlascloud.ai/api/v1
SEEDANCE_MODEL_NAME=bytedance/seedance-v1.5-pro/text-to-video

# Luma Dream Machine (Optional; unverified adapter)
LUMA_API_KEY=
LUMA_BASE_URL=https://api.lumalabs.ai/dream-machine/v1
LUMA_MODEL_NAME=ray-2

# ComfyUI local image generation (Optional; must be explicitly enabled)
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_FILE=./data/workflows/comfyui_default.json

# ── Blender Integration ──
BLENDER_BIN=blender
ENABLE_BLENDER_EXPORT=true
BLENDER_EXECUTION_MODE=local_batch

# ── Creative Production Pipeline ──
# LLM (OpenAI-compatible API) for storyboard generation
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# OpenAI Images (platform fallback for the openai_gpt_image_1 model)
# Users can also save their own per-account key on /api-settings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1

# Piper TTS (local, real audio)
PIPER_BIN=piper
PIPER_MODEL_PATH=./data/tts_models/zh_CN-huayan-medium.onnx
TTS_VOICES_FILE=./data/tts_voices.json
TTS_MODEL_DIR=./data/tts_models
TTS_DEFAULT_VOICE_ID=piper:zh_CN-huayan-medium
MAX_TTS_TEXT_LENGTH=2000

# FFmpeg / FFprobe + timeline composition
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_TIMEOUT_S=1800
SUBTITLE_FONT_NAME=Noto Sans CJK SC
SUBTITLE_FONT_SIZE=24
MAX_COMPOSE_DURATION_S=900
MAX_COMPOSE_INPUTS=200
MAX_COMPOSE_OUTPUT_MB=1500
MIN_OUTPUT_BYTES=4096
# Optional manifest for licensed preset music/SFX; empty keeps the preset
# library empty instead of fabricating audio.
PRESET_AUDIO_MANIFEST=

# ── Background Workers ──
# Production: run the web process with START_TASK_WORKER=false and run
# scripts/run_generation_worker.py as a separate service.
START_TASK_WORKER=false
ENABLE_MONITORING_WORKER=false
GENERATION_WORKER_CONCURRENCY=1
GENERATION_WORKER_POLL_INTERVAL_S=2
# Lease must exceed the longest synchronous provider call + download window.
GENERATION_TASK_LEASE_SECONDS=900
GENERATION_MAX_ATTEMPTS=3
GENERATION_POLL_INTERVAL_S=10
GENERATION_POLL_MAX_ERRORS=8
GENERATION_DOWNLOAD_TIMEOUT_S=180
# Overall task deadlines (seconds). Expired tasks fail with task_timeout while
# keeping provider_job_id so an admin can resume polling.
GENERATION_IMAGE_DEADLINE_S=1800
GENERATION_VIDEO_DEADLINE_S=7200
# Periodic stale-lease recovery even when the worker process stays alive.
GENERATION_RECOVERY_INTERVAL_S=60
# Connect timeout; read timeouts remain per-provider so long jobs are safe.
PROVIDER_CONNECT_TIMEOUT_S=10

# ── Upload / generation quotas ──
MAX_CONTENT_LENGTH=209715200
MAX_ASSET_UPLOAD_MB=200
MAX_AVATAR_UPLOAD_MB=2
MAX_GENERATION_DOWNLOAD_MB=500
MAX_AUDIO_UPLOAD_MB=50
MAX_PROMPT_LENGTH=4000
MAX_REFERENCE_IMAGE_MB=10
# Total raw bytes across all reference images in one task.
MAX_REFERENCE_IMAGES_TOTAL_MB=40
MAX_CONCURRENT_TASKS_PER_USER=2
DAILY_IMAGE_LIMIT=20
DAILY_VIDEO_LIMIT=5

# ── Security & Stability ──
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=3
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
CSRF_ENABLED=true
# Set true when served over HTTPS (required in production).
SESSION_SECURE=true
SESSION_LIFETIME_DAYS=7
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Optional future guard. Default false keeps the current HTTP deployment usable.
# Set true only after TLS termination is in place; credential writes over plain
# HTTP will then return 403 https_required.
CREDENTIAL_REQUIRE_HTTPS=false
AUDIT_ENABLED=true
SQLITE_WAL_MODE=true

# ── Per-user provider credentials ──
# Keys saved at /api-settings are encrypted with Fernet. When empty, a key is
# derived from SECRET_KEY; changing either value makes saved user keys
# unreadable (users must re-save them). No default is needed for single-host use.
CREDENTIAL_ENCRYPTION_KEY=
# Keep false in production: rejects http:// and private/loopback Base URLs.
ALLOW_INSECURE_PROVIDER_URLS=false

# ── Cloud Provider Credentials ──
# Aliyun
ALIYUN_ACCESS_KEY=
ALIYUN_ACCESS_SECRET=
ALIYUN_REGION_ID=cn-hangzhou

# Tencent Cloud
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou

# VMware
VMWARE_HOST=
VMWARE_USER=
VMWARE_PASSWORD=

# Generic REST
GENERIC_REST_URL=
GENERIC_REST_TOKEN=

# ── Node Agent ──
NODE_AGENT_URLS=
NODE_AGENT_TOKEN=
NODE_POLL_INTERVAL_S=30

# ── Monitoring & Alerting ──
# Comma-separated targets: "name|type|addr,name|type|addr"
# type: tcp, http, icmp. Example: "node1|tcp|10.0.0.11:9100,api|http|http://10.0.0.12:9108/health"
MONITOR_TARGETS=
MONITOR_INTERVAL_S=5
MONITOR_TIMEOUT_S=3
STORAGE_TARGETS=assets|./data/assets,work|./data/work,jobs|./data/jobs
ALERT_RULES_FILE=

# ── Billing ──
GPU_UNIT_PRICE_CNY=120
ENGINE_UNIT_PRICE_CNY=80
STREAM_UNIT_PRICE_CNY=40
GPU_PRICE_MAP=A100:150,A10:80,L40:120
