## 必填：Luma API Key
LUMA_API_KEY=replace_me

## 可选：Luma API Base URL（如后续版本变动可在这里切换）
LUMA_BASE_URL=https://api.lumalabs.ai/dream-machine/v1

## Seedance / Atlas Cloud（推荐当前使用）
SEEDANCE_API_KEY=replace_me
SEEDANCE_BASE_URL=https://api.atlascloud.ai/api/v1
SEEDANCE_MODEL_NAME=bytedance/seedance-v1.5-pro/text-to-video

## 可选：Blender 可执行文件路径（不在 PATH 时填写绝对路径）
BLENDER_BIN=blender

## 可选：运行时数据目录（jobs、导出产物）
DATA_DIR=./data

## 可选：本地知识库 JSON 路径
CATALOG_PATH=./data/catalog/knowledge_base.json

## 可选：是否启用 Blender 资产导出（true/false）
ENABLE_BLENDER_EXPORT=true

## 可选：Blender 执行模式（local_batch / mcp_remote）
BLENDER_EXECUTION_MODE=local_batch

## ── 创意生产管线 ──
## LLM (OpenAI-compatible API)
LLM_API_KEY=replace_me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

## ComfyUI 图片生成
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_FILE=./data/workflows/comfyui_default.json

## Piper TTS
PIPER_BIN=piper
PIPER_MODEL_PATH=./data/tts_models/zh_CN-huayan-medium.onnx

## FFmpeg
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

## 服务监听
HOST=0.0.0.0
PORT=8000
